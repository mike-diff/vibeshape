{
  "name": "@appshape/viewer",
  "version": "0.1.0",
  "description": "Read-only local web viewer for the .shape/ coverage map",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "node scripts/gen-client.mjs",
    "build": "pnpm gen && tsc -b",
    "typecheck": "pnpm gen && tsc -b --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "pnpm gen && tsc -b && vitest run"
  },
  "dependencies": {
    "@appshape/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
