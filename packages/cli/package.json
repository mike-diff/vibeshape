{
  "name": "appshape",
  "version": "0.1.0",
  "description": "A living coverage map for agent-built apps: tree of intent, scored against the code",
  "type": "module",
  "bin": {
    "shape": "./dist/main.js",
    "appshape": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "tsc -b && vitest run"
  },
  "dependencies": {
    "@appshape/core": "workspace:*",
    "@appshape/viewer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
